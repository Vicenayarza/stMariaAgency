generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  BRAND
  CREATOR
  STAFF
}

enum StaffRole {
  ADMIN
  MANAGER
  ACCOUNT
  FINANCE
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  TWITTER
  FACEBOOK
  TWITCH
  LINKEDIN
  OTHER
}

enum MetricSource {
  CREATOR
  STMARIA
  API
}

enum MetricVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  role         UserRole
  status       UserStatus @default(ACTIVE)

  brand   Brand?
  creator Creator?
  staff   StaffMember?

  sessions Session[]

  auditLogs AuditLog[]

  deliverableReviews DeliverableReview[]

  verifiedCreatorMetrics CreatorMetric[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
}

model Brand {
  id          String  @id @default(uuid())
  userId      String  @unique
  companyName String
  website     String?
  industry    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  campaigns Campaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Creator {
  id             String  @id @default(uuid())
  userId         String  @unique
  username       String  @unique
  bio            String?
  location       String?
  followers      Int     @default(0)
  engagementRate Float   @default(0)

  categories String[]
  platforms  String[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  campaignLinks CampaignCreator[]

  socialAccounts CreatorSocialAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([location])
  @@index([followers])
  @@index([engagementRate])
}

model Campaign {
  id      String @id @default(uuid())
  brandId String

  name        String
  description String?
  budget      Decimal @db.Decimal(12, 2)

  status    String  @default("DRAFT")
  objective String?
  category  String?
  platform  String?

  startDate DateTime?
  endDate   DateTime?

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  creators CampaignCreator[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([status])
}

model CampaignCreator {
  id         String   @id @default(uuid())
  campaignId String
  creatorId  String
  status     String   @default("PENDING")
  fee        Decimal? @db.Decimal(12, 2)

  contactedAt       DateTime?
  acceptedAt        DateTime?
  selectedAt        DateTime?
  productSentAt     DateTime?
  contentReceivedAt DateTime?
  publishedAt       DateTime?
  paidAt            DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator  Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  deliverables Deliverable[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, creatorId])
  @@index([campaignId])
  @@index([creatorId])
  @@index([status])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model StaffMember {
  id        String    @id @default(uuid())
  userId    String    @unique
  staffRole StaffRole

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

enum DeliverableStatus {
  PENDING
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
}

model Deliverable {
  id String @id @default(uuid())

  campaignCreatorId String

  type     String
  platform String?
  quantity Int     @default(1)

  description String?

  dueDate DateTime?

  status DeliverableStatus @default(PENDING)

  submittedAt DateTime?
  approvedAt  DateTime?

  contentUrl String?
  notes      String?

  revisionCount Int @default(0)

  campaignCreator CampaignCreator @relation(fields: [campaignCreatorId], references: [id], onDelete: Cascade)

  reviews DeliverableReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignCreatorId])
  @@index([status])
  @@index([dueDate])
}

model DeliverableReview {
  id String @id @default(uuid())

  deliverableId String

  status String

  feedback String

  createdById String?

  createdAt DateTime @default(now())

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([deliverableId])
  @@index([createdById])
  @@index([createdAt])
}

model CreatorSocialAccount {
  id String @id @default(uuid())

  creatorId String

  platform SocialPlatform
  username String

  profileUrl String?

  isConnected Boolean @default(false)

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  metrics CreatorMetric[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([creatorId, platform])
  @@index([creatorId])
  @@index([platform])
}

model CreatorMetric {
  id String @id @default(uuid())

  socialAccountId String

  followers Int @default(0)

  following Int?
  posts     Int?

  likes    Int @default(0)
  comments Int @default(0)
  views    Int @default(0)

  reach       Int?
  impressions Int?

  engagementRate Float @default(0)

  source MetricSource @default(CREATOR)

  verificationStatus MetricVerificationStatus @default(UNVERIFIED)

  verifiedById String?
  verifiedAt   DateTime?

  recordedAt DateTime @default(now())

  socialAccount CreatorSocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  verifiedBy User? @relation(fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([socialAccountId])
  @@index([recordedAt])
  @@index([verificationStatus])
  @@index([verifiedById])
}
